{
  "layer": "top",
  "position": "top",
  "exclusive": true,
  "height": 26,
  "spacing": 8,
  "margin-top": 6,
  "margin-left": 14,
  "margin-right": 14,
  "margin-bottom": 0,
  "modules-left": [
    "hyprland/workspaces"
  ],
  "modules-center": [
    "clock"
  ],
  "modules-right": [
    "group/right"
  ],
  "hyprland/workspaces": {
    "tooltip": false,
    "format": "{icon}",
    "format-icons": {
      "1": "",
      "2": "",
      "3": "",
      "4": "",
      "5": "",
      "active": "",
      "default": ""
    },
    "on-click": "activate",
    "on-scroll-up": "hyprctl dispatch workspace e+1",
    "on-scroll-down": "hyprctl dispatch workspace e-1",
    "all-outputs": true,
    "show-special": false,
    "persistent-workspaces": { "*": 5 }
  },
  "clock": {
    "format": "{:%I:%M %p    %A, %b %d}",
    "interval": 60,
    "on-click": "kitty -e calcurse",
    "tooltip": false
  },
  "custom/control": {
    "format": "󰄧",
    "on-click": "~/.config/hypr/scripts/toggle-control-center.sh",
    "tooltip": false
  },
  "group/right": {
    "orientation": "horizontal",
    "modules": [
      "cpu",
      "memory",
      "custom/net",
      "battery",
      "pulseaudio",
      "custom/cava",
      "custom/control"
    ]
  },
  "cpu": {
    "interval": 10,
    "format": "󰻠 {usage}%",
    "on-click": "kitty -e btop",
    "tooltip": false
  },
  "memory": {
    "interval": 30,
    "format": "󰍛 {used:0.1f}G",
    "on-click": "kitty -e btop",
    "tooltip": false
  },
  "custom/cava": {
    "format": "cava",
    "on-click": "kitty cava",
    "tooltip": false
  },
  "custom/net": {
    "exec": "~/.config/waybar/scripts/net-status.sh",
    "exec-on-event": true,
    "return-type": "json",
    "interval": 5,
    "format": "{}",
    "tooltip": false,
    "on-click": "kitty -e nmtui"
  },
  "battery": {
    "bat": "BAT1",
    "interval": 20,
    "format": "{icon} {capacity}%",
    "format-charging": " {capacity}%",
    "format-plugged": " {capacity}%",
    "format-icons": ["", "", "", "", ""],
    "states": { "warning": 25, "critical": 10 },
    "tooltip": false
  },
  "pulseaudio": {
    "format": "{icon}  {volume}%",
    "format-muted": " mute",
    "format-icons": {
      "default": ["", "", ""]
    },
    "tooltip": false,
    "on-click": "pavucontrol",
    "on-scroll-up": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%+",
    "on-scroll-down": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-"
  },
  "tray": {
    "tooltip": false,
    "icon-size": 16,
    "spacing": 10,
    "show-passive-items": false
  }
}
