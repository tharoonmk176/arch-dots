configuration {
    modi: "dmenu";
    show-icons: false;
    font: "JetBrainsMono Nerd Font 12";
}

@theme "base.rasi"

window {
    width: 460px;
}

listview {
    lines: 6;
    spacing: 4px;
}

element {
    padding: 12px 16px;
}

element selected {
    background-color: @selected;
    text-color:       @selected-fg;
}
