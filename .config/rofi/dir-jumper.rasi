configuration {
    modi: "dmenu";
    show-icons: false;
    cycle: true;
    font: "JetBrainsMono Nerd Font 11";
}

@theme "base.rasi"

window { width: 520px; }
mainbox { children: [ "inputbar", "listview" ]; }
entry { placeholder: "jump to directory…"; }
listview { lines: 8; scrollbar: true; scrollbar-width: 4px; scrollbar-color: @accent; scrollbar-background-color: @bg-alt; fixed-height: false; }
